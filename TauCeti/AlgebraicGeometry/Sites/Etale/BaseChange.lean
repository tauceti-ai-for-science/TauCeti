/-!
# The morphism of small étale sites induced by a morphism of schemes

A morphism of schemes `f : X ⟶ Y` induces a morphism from the small étale site of `X` to the small
étale site of `Y`. Its underlying functor is base change
`f.smallEtaleBaseChange : Y.Etale ⥤ X.Etale`, sending an étale `V ⟶ Y` to `V ×_Y X ⟶ X`. This
file shows that base change preserves finite limits
and covering sieves, hence is a continuous and representably flat functor of sites. A sieve of the
small étale site covers exactly when the morphisms it contains are jointly surjective
(`AlgebraicGeometry.Scheme.mem_smallEtaleTopology_iff`), and base change preserves joint
surjectivity.

Consequently Mathlib's pushforward `f.smallEtaleBaseChange.sheafPushforwardContinuous A _ _` is the
direct image `f_*` of étale sheaves, with `(f_* F)(V) = F(V ×_Y X)`. We show that it has a left
adjoint, the inverse image `f⁻¹ = f.smallEtaleBaseChange.sheafPullback A _ _` of étale sheaves, with
the adjunction `f.smallEtaleBaseChange.sheafAdjunctionContinuous A _ _ : f⁻¹ ⊣ f_*`. This holds for
every coefficient category `A` with `u`-small limits and colimits in which étale sheaves on `X` can
be sheafified, such as `Type u`, `AddCommGrpCat.{u}` and `ModuleCat.{u} R`.

The small étale site is not essentially small, so the left Kan extensions used to build `f⁻¹` are
not taken along base change itself. Instead, sheaves on the small étale site of `Y` are identified
with sheaves on its essentially small affine étale site (`AlgebraicGeometry.Scheme.AffineEtale`),
and the left Kan extensions are taken along the composite of `Spec` with base change, over
essentially small index categories.

## Main results

* `AlgebraicGeometry.Scheme.mem_smallEtaleTopology_iff`: covering sieves of the small étale site
  are the jointly surjective ones.
* `AlgebraicGeometry.Scheme.Hom.smallEtaleBaseChange`: base change `Y.Etale ⥤ X.Etale` along
  `f : X ⟶ Y`.
* `AlgebraicGeometry.Scheme.Hom.coverPreserving_smallEtaleBaseChange`: base change preserves
  covering sieves.
* `Functor.IsContinuous f.smallEtaleBaseChange Y.smallEtaleTopology X.smallEtaleTopology` and
  `RepresentablyFlat f.smallEtaleBaseChange`: base change is a morphism of sites.
* `Functor.IsRightAdjoint (f.smallEtaleBaseChange.sheafPushforwardContinuous A _ _)`: the direct
  image of étale sheaves has a left adjoint, the inverse image.

## References

* The Stacks Project, Section 59.36, *Functoriality of small étale topos* (tag 03PH).
* M. Artin, A. Grothendieck, J.-L. Verdier, *SGA 4*, Exposé VII, §1.
-/

public section

open CategoryTheory Limits MorphismProperty

universe u u'

namespace AlgebraicGeometry.Scheme

/-- A sieve on an object `V` of the small étale site is covering exactly when the morphisms it
contains are jointly surjective onto `V`. -/
theorem mem_smallEtaleTopology_iff {S : Scheme.{u}} {V : S.Etale} (R : Sieve V) :
    R ∈ S.smallEtaleTopology V ↔
      ∀ x : V.left, ∃ (W : S.Etale) (g : W ⟶ V) (w : W.left), R g ∧ g.left w = x := by
  -- The small étale topology is generated by jointly surjective families of étale morphisms;
  -- morphisms of the small étale site are automatically étale.
  have h := S.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
    (P := (@Etale : MorphismProperty Scheme.{u})) (Q := (@Etale : MorphismProperty Scheme.{u}))
    le_rfl
  refine (Iff.of_eq (congrArg (R ∈ · V) h)).trans
    ((mem_toGrothendieck_smallPretopology (P := (@Etale : MorphismProperty Scheme.{u})) V R).trans
      (forall_congr' fun x ↦ ?_))
  constructor
  · rintro ⟨W, g, w, hg, -, hw⟩
    exact ⟨W, g, w, hg, hw⟩
  · rintro ⟨W, g, w, hg, hw⟩
    exact ⟨W, g, w, hg, inferInstance, hw⟩

namespace Hom

variable {X Y : Scheme.{u}} (f : X ⟶ Y)

/-- Base change along `f : X ⟶ Y`, from schemes étale over `Y` to schemes étale over `X`: an étale
`V ⟶ Y` is sent to `V ×_Y X ⟶ X`. -/
noncomputable def smallEtaleBaseChange : Y.Etale ⥤ X.Etale :=
  MorphismProperty.Over.pullback @Etale ⊤ f

/-- On underlying schemes over `X`, `smallEtaleBaseChange f` is base change along `f`. -/
noncomputable def smallEtaleBaseChangeCompForgetIso :
    f.smallEtaleBaseChange ⋙ Etale.forget X ≅ Etale.forget Y ⋙ Over.pullback f :=
  Iso.refl _

/-- Base change of étale schemes preserves finite limits, since base change of schemes over `Y`
does and limits of étale schemes are computed as schemes over the base. -/
instance : PreservesFiniteLimits f.smallEtaleBaseChange := by
  have : PreservesFiniteLimits (f.smallEtaleBaseChange ⋙ Etale.forget X) :=
    preservesFiniteLimits_of_natIso f.smallEtaleBaseChangeCompForgetIso.symm
  exact preservesFiniteLimits_of_reflects_of_preserves _ (Etale.forget X)

instance : RepresentablyFlat f.smallEtaleBaseChange :=
  flat_of_preservesFiniteLimits _

/-- A point of `V ×_Y X` whose image in `V` lifts along `g : W ⟶ V` lifts to `W ×_Y X`. -/
private theorem exists_pullbackLift_apply_eq {W V : Scheme.{u}} {a : W ⟶ Y} {b : V ⟶ Y}
    (g : W ⟶ V) (hg : g ≫ b = a) (p : ↥(pullback b f)) {w : W}
    (hw : g w = pullback.fst b f p) :
    ∃ q : ↥(pullback a f), pullback.lift (pullback.fst a f ≫ g) (pullback.snd a f)
      (by simp [hg, pullback.condition]) q = p := by
  have h := Scheme.Pullback.range_map a f b f g (𝟙 X) (𝟙 Y) (by simp [hg]) (by simp)
  simp only [pullback.map, Category.comp_id] at h
  exact h.ge ⟨⟨w, hw⟩, by simp⟩

/-- Base change of étale schemes along `f` sends covering sieves of the small étale site of `Y` to
covering sieves of the small étale site of `X`. -/
theorem coverPreserving_smallEtaleBaseChange :
    CoverPreserving Y.smallEtaleTopology X.smallEtaleTopology f.smallEtaleBaseChange where
  cover_preserve {V} R hR := by
    rw [mem_smallEtaleTopology_iff] at hR ⊢
    intro p
    obtain ⟨W, g, w, hg, hw⟩ := hR (pullback.fst V.hom f p)
    obtain ⟨q, hq⟩ := exists_pullbackLift_apply_eq f g.left (Over.w g) p hw
    exact ⟨_, f.smallEtaleBaseChange.map g, q, Sieve.image_mem_functorPushforward _ _ hg, hq⟩

/-- Base change of étale schemes is a continuous functor of small étale sites: precomposing an
étale sheaf on `X` with it gives an étale sheaf on `Y`, its direct image. -/
instance : f.smallEtaleBaseChange.IsContinuous Y.smallEtaleTopology X.smallEtaleTopology :=
  Functor.isContinuous_of_coverPreserving (compatiblePreservingOfFlat _ _)
    (coverPreserving_smallEtaleBaseChange f)

variable (A : Type u') [Category.{u} A] [HasLimitsOfSize.{u, u} A] [HasColimitsOfSize.{u, u} A]

/-- The direct image `f_*` of étale sheaves along `f : X ⟶ Y` has a left adjoint, the inverse image
`f.smallEtaleBaseChange.sheafPullback A Y.smallEtaleTopology X.smallEtaleTopology`. -/
instance [HasWeakSheafify X.smallEtaleTopology A] :
    (f.smallEtaleBaseChange.sheafPushforwardContinuous A Y.smallEtaleTopology
      X.smallEtaleTopology).IsRightAdjoint := by
  -- Precomposing with the equivalence between étale sheaves on `Y` and sheaves on its affine
  -- étale site does not change whether `f_*` is a right adjoint.
  have := Functor.isEquivalence_of_isOneHypercoverDense.{u} (AffineEtale.Spec Y)
    (AffineEtale.topology Y) Y.smallEtaleTopology A
  rw [← Functor.isRightAdjoint_comp_iff_left _
    ((AffineEtale.Spec Y).sheafPushforwardContinuous A (AffineEtale.topology Y)
      Y.smallEtaleTopology)]
  -- The composite is the pushforward along `G`, whose left Kan extensions are indexed by
  -- essentially small categories since the affine étale site is essentially small.
  let G := AffineEtale.Spec Y ⋙ f.smallEtaleBaseChange
  have := Functor.isContinuous_comp (AffineEtale.Spec Y) f.smallEtaleBaseChange
    (AffineEtale.topology Y) Y.smallEtaleTopology X.smallEtaleTopology
  have (d : X.Etaleᵒᵖ) : HasColimitsOfShape (CostructuredArrow G.op d) A :=
    hasColimitsOfShape_of_essentiallySmall _ _
  have (F : (AffineEtale Y)ᵒᵖ ⥤ A) : G.op.HasLeftKanExtension F := inferInstance
  exact Functor.isRightAdjoint_of_iso (Functor.sheafPushforwardContinuousComp
    (F := AffineEtale.Spec Y) (G := f.smallEtaleBaseChange) (A := A) (J := AffineEtale.topology Y)
    (K := Y.smallEtaleTopology) (L := X.smallEtaleTopology)).symm

end Hom

end AlgebraicGeometry.Scheme
