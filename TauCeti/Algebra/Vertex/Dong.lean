/-!
# Dong's lemma for nonnegative residue products

If the fields `A`, `B` and `C` are pairwise mutually local, of orders `N₁` (for `A, B`),
`N₂` (for `A, C`) and `N₃` (for `B, C`), then every nonnegative residue product
`A₍ₙ₎B = Res_z (z - w)ⁿ [A(z), B(w)]` is local to `C` of order at most `N₁ + N₂ + N₃`
(`VertexOperator.isLocalOfOrder_nonnegResidueProduct`).

This closure property is what makes the space of fields generated by mutually local fields
under residue products again mutually local. It is used to identify the residue products of the
fields of a vertex algebra with the fields of the corresponding modes.

The proof is coefficientwise and uses only polynomial multipliers, so no products of formal
distributions with incompatible supports occur. Consider the three-variable distribution
`X(z, w, x) = [[A(z), B(w)], C(x)]`. Since `w - x = (z - x) - (z - w)`, the power
`(w - x)^(N₁ + N₂ + N₃)` expands into terms divisible by `(z - w)^N₁`, which kills `[A(z), B(w)]`,
or by `(z - x)^N₂ (w - x)^N₃`. The latter kills `X` because the Jacobi identity rewrites `X` as
a sum of terms killed by `(z - x)^N₂` (they contain `[A(z), C(x)]`) and terms killed by
`(w - x)^N₃` (they contain `[B(w), C(x)]`). Taking the residue in `z` after multiplying by
`(z - w)ⁿ` gives the commutator of `A₍ₙ₎B` with `C`.

## References

* C. Dong, *Vertex algebras associated with even lattices*, J. Algebra 161 (1993), 245–265.
* V. Kac, *Vertex Algebras for Beginners*, 2nd ed., §3.2 (Dong's lemma).
* E. Frenkel, D. Ben-Zvi, *Vertex Algebras and Algebraic Curves*, 2nd ed., §3.2.
-/

public section

noncomputable section

open scoped VertexOperator
open TauCeti TauCeti.FormalDistribution

namespace VertexOperator

/-! ### Three-variable distributions

A three-variable distribution `c : ℤ → ℤ → ℤ → M` is indexed so that `c p q r` is the coefficient
of `z^(-p-1) w^(-q-1) x^(-r-1)`. Multiplication by `z - w`, `z - x` and `w - x` acts on it by
shifts; on each pair of variables it is the two-variable multiplication `mulSub`. -/

section ThreeVariable

variable {M : Type*} [AddCommGroup M]

/-- Multiplication of a three-variable distribution by `z - w`. -/
private def mulSub₁₂ : Module.End ℤ (ℤ → ℤ → ℤ → M) where
  toFun c p q r := c (p + 1) q r - c p (q + 1) r
  map_add' c d := by ext p q r; simp only [Pi.add_apply]; abel
  map_smul' k c := by ext p q r; simp [smul_sub]

/-- Multiplication of a three-variable distribution by `z - x`. -/
private def mulSub₁₃ : Module.End ℤ (ℤ → ℤ → ℤ → M) where
  toFun c p q r := c (p + 1) q r - c p q (r + 1)
  map_add' c d := by ext p q r; simp only [Pi.add_apply]; abel
  map_smul' k c := by ext p q r; simp [smul_sub]

/-- Multiplication of a three-variable distribution by `w - x`. -/
private def mulSub₂₃ : Module.End ℤ (ℤ → ℤ → ℤ → M) where
  toFun c p q r := c p (q + 1) r - c p q (r + 1)
  map_add' c d := by ext p q r; simp only [Pi.add_apply]; abel
  map_smul' k c := by ext p q r; simp [smul_sub]

private theorem mulSub₁₂_apply (c : ℤ → ℤ → ℤ → M) (p q r : ℤ) :
    mulSub₁₂ (M := M) c p q r = c (p + 1) q r - c p (q + 1) r := (rfl)

private theorem mulSub₁₃_apply (c : ℤ → ℤ → ℤ → M) (p q r : ℤ) :
    mulSub₁₃ (M := M) c p q r = c (p + 1) q r - c p q (r + 1) := (rfl)

private theorem mulSub₂₃_apply (c : ℤ → ℤ → ℤ → M) (p q r : ℤ) :
    mulSub₂₃ (M := M) c p q r = c p (q + 1) r - c p q (r + 1) := (rfl)

/-- Powers of `z - w` act on the first two variables as powers of `mulSub`. -/
private theorem mulSub₁₂_pow_apply (N : ℕ) (c : ℤ → ℤ → ℤ → M) (p q r : ℤ) :
    (mulSub₁₂ (M := M) ^ N) c p q r = (mulSub ^ N) (fun p q ↦ c p q r) p q := by
  induction N generalizing p q with
  | zero => rfl
  | succ N ih => rw [pow_succ', mul_apply_eq_comp, mulSub₁₂_apply, ih, ih, pow_succ',
      AddMonoid.End.coe_mul, Function.comp_apply, mulSub_apply]

/-- Powers of `z - x` act on the first and third variables as powers of `mulSub`. -/
private theorem mulSub₁₃_pow_apply (N : ℕ) (c : ℤ → ℤ → ℤ → M) (p q r : ℤ) :
    (mulSub₁₃ (M := M) ^ N) c p q r = (mulSub ^ N) (fun p r ↦ c p q r) p r := by
  induction N generalizing p r with
  | zero => rfl
  | succ N ih => rw [pow_succ', mul_apply_eq_comp, mulSub₁₃_apply, ih, ih, pow_succ',
      AddMonoid.End.coe_mul, Function.comp_apply, mulSub_apply]

/-- Powers of `w - x` act on the last two variables as powers of `mulSub`. -/
private theorem mulSub₂₃_pow_apply (N : ℕ) (c : ℤ → ℤ → ℤ → M) (p q r : ℤ) :
    (mulSub₂₃ (M := M) ^ N) c p q r = (mulSub ^ N) (fun q r ↦ c p q r) q r := by
  induction N generalizing q r with
  | zero => rfl
  | succ N ih => rw [pow_succ', mul_apply_eq_comp, mulSub₂₃_apply, ih, ih, pow_succ',
      AddMonoid.End.coe_mul, Function.comp_apply, mulSub_apply]

/-- `w - x = (z - x) - (z - w)`. -/
private theorem mulSub₂₃_eq_sub :
    (mulSub₂₃ : Module.End ℤ (ℤ → ℤ → ℤ → M)) = mulSub₁₃ - mulSub₁₂ := by
  ext c p q r
  simp only [mulSub₂₃_apply, LinearMap.sub_apply, Pi.sub_apply, mulSub₁₃_apply, mulSub₁₂_apply]
  abel

private theorem commute_mulSub₁₃_mulSub₁₂ :
    Commute (mulSub₁₃ : Module.End ℤ (ℤ → ℤ → ℤ → M)) mulSub₁₂ := by
  ext c p q r
  simp only [mul_apply_eq_comp, mulSub₁₃_apply, mulSub₁₂_apply]
  abel

private theorem commute_mulSub₂₃_mulSub₁₂ :
    Commute (mulSub₂₃ : Module.End ℤ (ℤ → ℤ → ℤ → M)) mulSub₁₂ := by
  rw [mulSub₂₃_eq_sub]
  exact commute_mulSub₁₃_mulSub₁₂.sub_left (Commute.refl _)

private theorem commute_mulSub₂₃_mulSub₁₃ :
    Commute (mulSub₂₃ : Module.End ℤ (ℤ → ℤ → ℤ → M)) mulSub₁₃ := by
  rw [mulSub₂₃_eq_sub]
  exact (Commute.refl _).sub_left commute_mulSub₁₃_mulSub₁₂.symm

/-- If `(z - w)^N₁` and `(z - x)^N₂` both kill a distribution, so does `(w - x)^(N₂ + N₁)`. -/
private theorem mulSub₂₃_pow_eq_zero {c : ℤ → ℤ → ℤ → M} {N₁ N₂ : ℕ}
    (h₁ : (mulSub₁₂ (M := M) ^ N₁) c = 0) (h₂ : (mulSub₁₃ (M := M) ^ N₂) c = 0) :
    (mulSub₂₃ (M := M) ^ (N₂ + N₁)) c = 0 := by
  have hc : c ∈ (mulSub₁₃.genEigenspace 0 N₂ ⊓ (-mulSub₁₂).genEigenspace 0 N₁ :
      Submodule ℤ (ℤ → ℤ → ℤ → M)) := by
    rw [Submodule.mem_inf, Module.End.mem_genEigenspace_nat, Module.End.mem_genEigenspace_nat,
      zero_smul, sub_zero, sub_zero, LinearMap.mem_ker, LinearMap.mem_ker, neg_pow,
      mul_apply_eq_comp, h₁, map_zero]
    exact ⟨h₂, rfl⟩
  have h := Module.End.genEigenspace_inf_le_add _ _ _ _ _ _
    (commute_mulSub₁₃_mulSub₁₂ (M := M)).neg_right hc
  rw [add_zero, ← Nat.cast_add, Module.End.mem_genEigenspace_nat, zero_smul, sub_zero,
    ← sub_eq_add_neg, ← mulSub₂₃_eq_sub] at h
  exact h

/-- The three-variable core of Dong's lemma. For mode families `a`, `b`, `c` in a ring whose
commutator distributions are killed by `(z - w)^N₁`, `(z - x)^N₂` and `(w - x)^N₃`, the
distribution `[[a(z), b(w)], c(x)]` is killed by `(w - x)^(N₁ + N₂ + N₃)`, and hence so is its
residue in `z` after multiplication by `(z - w)ⁿ`. -/
private theorem mulSub_pow_residue_jacobi_eq_zero {M : Type*} [Ring M] (a b c : ℤ → M)
    {N₁ N₂ N₃ : ℕ} (hab : (mulSub ^ N₁) (fun p q ↦ a p * b q - b q * a p) = 0)
    (hac : (mulSub ^ N₂) (fun p r ↦ a p * c r - c r * a p) = 0)
    (hbc : (mulSub ^ N₃) (fun q r ↦ b q * c r - c r * b q) = 0) (n : ℕ) :
    (mulSub ^ (N₁ + N₂ + N₃)) (fun q r ↦
      (mulSub ^ n) (fun p q ↦ a p * b q - b q * a p) 0 q * c r -
        c r * (mulSub ^ n) (fun p q ↦ a p * b q - b q * a p) 0 q) = 0 := by
  set cab : FormalDistribution M := fun p q ↦ a p * b q - b q * a p
  set cac : FormalDistribution M := fun p r ↦ a p * c r - c r * a p
  set cbc : FormalDistribution M := fun q r ↦ b q * c r - c r * b q
  -- The distribution `[[a(z), b(w)], c(x)]`, in two ways via the Jacobi identity.
  set P₁ : ℤ → ℤ → ℤ → M := fun p q r ↦ cab p q * c r
  set P₂ : ℤ → ℤ → ℤ → M := fun p q r ↦ c r * cab p q
  set Q₁ : ℤ → ℤ → ℤ → M := fun p q r ↦ a p * cbc q r
  set Q₂ : ℤ → ℤ → ℤ → M := fun p q r ↦ cbc q r * a p
  set Q₃ : ℤ → ℤ → ℤ → M := fun p q r ↦ cac p r * b q
  set Q₄ : ℤ → ℤ → ℤ → M := fun p q r ↦ b q * cac p r
  have hjacobi : P₁ - P₂ = (Q₁ - Q₂) + (Q₃ - Q₄) := by
    ext p q r
    simp only [P₁, P₂, Q₁, Q₂, Q₃, Q₄, cab, cac, cbc, Pi.add_apply, Pi.sub_apply]
    noncomm_ring
  -- `(z - w)^N₁` kills `[[a(z), b(w)], c(x)]`.
  have h₁₂ : (mulSub₁₂ (M := M) ^ N₁) (P₁ - P₂) = 0 := by
    rw [map_sub, sub_eq_zero]
    ext p q r
    simp only [mulSub₁₂_pow_apply, P₁, P₂, mulSub_pow_mul_left_apply, mulSub_pow_mul_right_apply,
      hab, Pi.zero_apply, zero_mul, mul_zero]
  -- `(z - x)^N₂ (w - x)^N₃` kills it as well.
  have h₂₃ : (mulSub₂₃ (M := M) ^ N₃) (Q₁ - Q₂) = 0 := by
    rw [map_sub, sub_eq_zero]
    ext p q r
    simp only [mulSub₂₃_pow_apply, Q₁, Q₂, mulSub_pow_mul_left_apply, mulSub_pow_mul_right_apply,
      hbc, Pi.zero_apply, zero_mul, mul_zero]
  have h₁₃ : (mulSub₁₃ (M := M) ^ N₂) (Q₃ - Q₄) = 0 := by
    rw [map_sub, sub_eq_zero]
    ext p q r
    simp only [mulSub₁₃_pow_apply, Q₃, Q₄, mulSub_pow_mul_left_apply, mulSub_pow_mul_right_apply,
      hac, Pi.zero_apply, zero_mul, mul_zero]
  have hZ₁ : (mulSub₁₂ (M := M) ^ N₁) ((mulSub₂₃ (M := M) ^ N₃) (P₁ - P₂)) = 0 := by
    rw [← mul_apply_eq_comp, ((commute_mulSub₂₃_mulSub₁₂ (M := M)).pow_pow N₃ N₁).symm.eq,
      mul_apply_eq_comp, h₁₂, map_zero]
  have hZ₂ : (mulSub₁₃ (M := M) ^ N₂) ((mulSub₂₃ (M := M) ^ N₃) (P₁ - P₂)) = 0 := by
    rw [hjacobi, map_add, map_add, h₂₃, map_zero, zero_add, ← mul_apply_eq_comp,
      ((commute_mulSub₂₃_mulSub₁₃ (M := M)).pow_pow N₃ N₂).symm.eq, mul_apply_eq_comp, h₁₃,
      map_zero]
  -- Hence `(w - x)^(N₁ + N₂ + N₃)` kills `[[a(z), b(w)], c(x)]`.
  have hX : (mulSub₂₃ (M := M) ^ (N₁ + N₂ + N₃)) (P₁ - P₂) = 0 := by
    rw [show N₁ + N₂ + N₃ = (N₂ + N₁) + N₃ by ring, pow_add, mul_apply_eq_comp]
    exact mulSub₂₃_pow_eq_zero hZ₁ hZ₂
  -- Take the `n`th residue in `z`.
  have hres : (fun q r ↦ (mulSub ^ n) cab 0 q * c r - c r * (mulSub ^ n) cab 0 q) =
      fun q r ↦ (mulSub₁₂ (M := M) ^ n) (P₁ - P₂) 0 q r := by
    ext q r
    rw [map_sub, Pi.sub_apply, Pi.sub_apply, Pi.sub_apply]
    simp only [mulSub₁₂_pow_apply, P₁, P₂, mulSub_pow_mul_left_apply, mulSub_pow_mul_right_apply]
  ext q r
  rw [hres, ← mulSub₂₃_pow_apply, ← mul_apply_eq_comp,
    ((commute_mulSub₂₃_mulSub₁₂ (M := M)).pow_pow _ _).eq, mul_apply_eq_comp, hX, map_zero]
  simp only [Pi.zero_apply]

end ThreeVariable

/-! ### Dong's lemma -/

variable {R V : Type*} [CommRing R] [AddCommGroup V] [Module R V]

/-- **Dong's lemma** for nonnegative residue products: if `A`, `B` and `C` are pairwise mutually
local, of orders `N₁` (for `A, B`), `N₂` (for `A, C`) and `N₃` (for `B, C`), then each
nonnegative residue product `A₍ₙ₎B` is local to `C` of order at most `N₁ + N₂ + N₃`. -/
theorem isLocalOfOrder_nonnegResidueProduct {A B C : VertexOperator R V} {N₁ N₂ N₃ : ℕ}
    (hAB : A.IsLocalOfOrder B N₁) (hAC : A.IsLocalOfOrder C N₂) (hBC : B.IsLocalOfOrder C N₃)
    (n : ℕ) : (nonnegResidueProduct n A B).IsLocalOfOrder C (N₁ + N₂ + N₃) := by
  have hc (A B : VertexOperator R V) :
      A.commutatorDistribution B = fun p q ↦ A[[p]] * B[[q]] - B[[q]] * A[[p]] := by
    funext p q
    exact commutatorDistribution_apply A B p q
  rw [isLocalOfOrder_iff_mulSub_pow_eq_zero, hc] at hAB hAC hBC ⊢
  have hres (k : ℤ) : (nonnegResidueProduct n A B)[[k]] =
      (mulSub ^ n) (fun p q ↦ A[[p]] * B[[q]] - B[[q]] * A[[p]]) 0 k := by
    simpa [hc] using (congrFun (residue_mulSub_pow_commutatorDistribution n A B) k).symm
  simp only [hres]
  exact mulSub_pow_residue_jacobi_eq_zero (fun p ↦ A[[p]]) (fun q ↦ B[[q]]) (fun r ↦ C[[r]])
    hAB hAC hBC n

end VertexOperator
